# Backend Environment Variables

# Application Details
PROJECT_NAME="Lead Finder Agent API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# Local MongoDB Connection String
MONGODB_URL=mongodb://localhost:27017/lead_finder_agent
DATABASE_NAME=lead_finder_agent

# Security & Authentication
# JWT Secret Key (Used to sign user auth tokens)
# Generate a secure random string for production
SECRET_KEY=supersecretkey_change_in_production

# Cryptography Fernet Key (Used to symmetrically encrypt user API Keys before DB save)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_your_own_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Admin User (Optional - for initial setup)
# Set these to automatically create an admin user on first startup
# ADMIN_EMAIL=your.admin@email.com
# ADMIN_PASSWORD=YourSecurePassword123
# ADMIN_NAME=System Administrator

# SSL Configuration
# Set to 'true' to disable SSL verification for model downloads (only use in development)
DISABLE_SSL_VERIFICATION=false

# Fallback SMTP Automation Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Fallback WhatsApp Provider
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
